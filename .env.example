# Copy to .env for seed scripts. The Next.js app can also read .env.local.
# Leave these empty to run the browser-only local demo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible alternative accepted by the app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required by npm run db:seed and npm run test:rls.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the one-click "Masuk sebagai Juri" button.
LARIS_DEMO_EMAIL=juri@example.com
LARIS_DEMO_PASSWORD=

# Optional. Without this key, AI routes use deterministic fallbacks.
GOOGLE_GENERATIVE_AI_API_KEY=
LARIS_AI_MODEL_FAST=gemini-3.8-flash
LARIS_AI_MODEL_SMART=gemini-3.8-flash
