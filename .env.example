# Copy to .env for seed scripts and the Next.js app.
# Leave Supabase values empty to use the explicit browser-only demo at /demo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible alternative accepted by the app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public application origin used for auth redirects. Use the HTTPS origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Required for seed/RLS scripts and invitations to new email addresses.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Enables the one-click "Masuk sebagai Juri" button and cloud demo seed.
LARIS_DEMO_EMAIL=juri@example.com
LARIS_DEMO_PASSWORD=
# In production builds the judge button stays hidden unless this is "true".
# Enable it only on the judging deployment, never on a real customer deployment.
LARIS_ALLOW_DEMO_LOGIN=false

# Optional. Text parsing and rule-based answers work without this key.
# Cloud receipt OCR requires Gemini; local-demo OCR is explicitly marked as simulated.
GOOGLE_GENERATIVE_AI_API_KEY=
LARIS_AI_MODEL_FAST=gemini-2.5-flash
LARIS_AI_MODEL_SMART=gemini-2.5-flash
